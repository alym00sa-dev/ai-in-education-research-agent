# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...        # used by QA node (Claude Opus) and PDF extractors

# ── Web search ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
ASTA_TOOL_KEY=...                   # ASTA education search API

# ── Academic databases ────────────────────────────────────────────────────────
# ERIC: no API key required (public API)
# OpenAlex: no API key required (public API)
# arXiv: no API key required (public API)
ELSEVIER_API_KEY=...                # Scopus / ScienceDirect (Elsevier developer portal)
SERPAPI_API_KEY=...                 # Google Scholar via SerpAPI
SEMANTIC_SCHOLAR_API_KEY=...        # Semantic Scholar (optional — raises rate limits)

# ── Neo4j (knowledge graph) ───────────────────────────────────────────────────
# Local:   NEO4J_URI=bolt://localhost:7687
# Aura:    NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j

# ── Optional / advanced ───────────────────────────────────────────────────────
# GET_API_KEYS_FROM_CONFIG=false    # set to "true" to read keys from LangGraph config instead of env